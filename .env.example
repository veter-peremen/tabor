BOT_TOKEN=123456:ABC-DEF...

# ID суперадминов через запятую
SUPERADMIN_IDS=111111111,222222222

# Путь к файлу локальной базы SQLite (можно не менять)
DB_PATH=events.db

# Необязательно: прокси, если Telegram недоступен напрямую.
# HTTP(S): PROXY=http://127.0.0.1:12334 ; SOCKS5: PROXY=socks5://host:port (нужен aiohttp-socks)
# Пусто — если прокси не нужен.
PROXY=
